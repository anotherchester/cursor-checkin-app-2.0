{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Vite: Run and Debug",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/src",
      "preLaunchTask": "npm: dev",
      "presentation": {
        "hidden": false,
        "group": "vite"
      }
    },
    {
      "name": "npm: build",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run build",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "hidden": false,
        "group": "vite"
      }
    }
  ]
}
